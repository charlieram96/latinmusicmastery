{"id":"local-solfeo-m12-c25","module":12,"number":25,"title":"Solucionario final · Preguntas 1-10","sourceTopics":["soluciones-final-1"],"sourcePages":[283,284],"pages":[{"title":"Solucionario final · Preguntas 1-10","blocks":[{"type":"h","text":"Solucionario final · Preguntas 1-10","pdfPage":283},{"type":"small","text":"<b>1.</b> Redonda, blanca, negra y corchea.","_sourcePage":"soluciones-final-1","pdfPage":283,"sourceBlock":26},{"type":"small","text":"<b>2.</b> Todas las figuras están en sol4, segunda línea de la clave de Sol.","_sourcePage":"soluciones-final-1","pdfPage":283,"sourceBlock":27},{"type":"small","text":"<b>3.</b> Cabeza llena sobre sol4; plica y un corchete correctamente identificados.","_sourcePage":"soluciones-final-1","pdfPage":283,"sourceBlock":28},{"type":"small","text":"<b>4.</b> 1/2 de redonda.","_sourcePage":"soluciones-final-1","pdfPage":283,"sourceBlock":29},{"type":"small","text":"<b>5.</b> Silencios de redonda, blanca, negra y corchea; mismas duraciones respectivas.","_sourcePage":"soluciones-final-1","pdfPage":283,"sourceBlock":30},{"type":"small","text":"<b>6.</b> Do4; primera línea adicional inferior.","_sourcePage":"soluciones-final-1","pdfPage":283,"sourceBlock":31},{"type":"small","text":"<b>7.</b> Do4, mi4, sol4, si4 y re5 están en líneas; fa4 está en el primer espacio.","_sourcePage":"soluciones-final-1","pdfPage":284,"sourceBlock":0},{"type":"small","text":"<b>8.</b> C, E, F, G, B, D.","_sourcePage":"soluciones-final-1","pdfPage":284,"sourceBlock":1},{"type":"small","text":"<b>9.</b> Mismas posiciones y clave; cabezas huecas con plicas, valor de blanca.","_sourcePage":"soluciones-final-1","pdfPage":284,"sourceBlock":2},{"type":"small","text":"<b>10.</b> Evaluar: clave, alturas, figuras, líneas adicionales y claridad.","_sourcePage":"soluciones-final-1","pdfPage":284,"sourceBlock":3}]}],"practice":[],"vectors":{},"nextHref":"/solfeo-preview?class=local-solfeo-m12-c26"}
