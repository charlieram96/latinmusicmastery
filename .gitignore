# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# worktrees
.worktrees/

# Blender automatic revision backups
/art/playsense/*.blend[0-9]
/scripts/blender/__pycache__/

# Local dependency cache and artifact rendering scratch files
/.pnpm-store/
/tmp/
**/__pycache__/

# Local optimized introduction preview (retain the master separately)
/public/local-course-assets/eb756201-e82e-4c37-a3c1-9d6e3dd975a4-1791599647914.m4v

/public/local-course-assets/codex-ritmo/ritmo-basico-aligned.mp4

/public/local-course-assets/codex-ritmo/codex-ritmo-original.m4v

/public/local-course-assets/codex-ritmo/codex-ritmo-audio-corrected.mp4

# Local audio processing intermediates (published audio lives under public/)
/local-artifacts/elevenlabs-variaciones-*/stems-*/
/local-artifacts/elevenlabs-variaciones-*/source-es.*
/local-artifacts/elevenlabs-variaciones-test/

# Interrupted writes and tool scratch files
*.tmp
*.log

# Published media is versioned by checksum in lib/release/manifest.json.
/public/local-course-assets/
