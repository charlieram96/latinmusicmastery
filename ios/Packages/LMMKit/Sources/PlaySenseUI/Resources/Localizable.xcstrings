{
  "sourceLanguage" : "en",
  "strings" : {
    "calibration.calibratingFormat" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Calibrating: %@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Calibrando: %@" } }
      }
    },
    "calibration.countIn" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Count-in… get ready to tap!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cuenta de entrada… ¡prepárate para tocar!" } }
      }
    },
    "calibration.engineErrorFormat" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't start calibration: %@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo iniciar la calibración: %@" } }
      }
    },
    "calibration.failure.notEnoughTaps" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not enough taps detected (%1$d of %2$d minimum). Make sure your mic is registering taps and try again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se detectaron suficientes toques (%1$d de %2$d mínimo). Asegúrate de que el micrófono registre tus toques e inténtalo de nuevo." } }
      }
    },
    "calibration.failure.notEnoughValidTaps" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not enough valid taps detected (%1$d of %2$d minimum). Tap more closely to the beat and try again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se detectaron suficientes toques válidos (%1$d de %2$d mínimo). Toca más cerca del pulso e inténtalo de nuevo." } }
      }
    },
    "calibration.failure.tooInconsistent" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap timing was too inconsistent. Try tapping more steadily with the beat." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El ritmo de tus toques fue demasiado irregular. Intenta tocar de forma más constante con el pulso." } }
      }
    },
    "calibration.heading" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio Calibration" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Calibración de audio" } }
      }
    },
    "calibration.interrupted.audio" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Calibration was interrupted (e.g. a phone call or another app using audio). Please try again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La calibración se interrumpió (por ejemplo, una llamada u otra app usando el audio). Inténtalo de nuevo." } }
      }
    },
    "calibration.interrupted.backgrounded" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Calibration was interrupted because the app moved to the background. Please try again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La calibración se interrumpió porque la app pasó a segundo plano. Inténtalo de nuevo." } }
      }
    },
    "calibration.interrupted.route" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your audio route changed during calibration (e.g. headphones connected or disconnected). Please try again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu ruta de audio cambió durante la calibración (por ejemplo, se conectaron o desconectaron los auriculares). Inténtalo de nuevo." } }
      }
    },
    "calibration.interrupted.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Calibration interrupted" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Calibración interrumpida" } }
      }
    },
    "calibration.introBody" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use headphones for best results. Calibration takes about 15 seconds." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Usa auriculares para obtener mejores resultados. La calibración tarda unos 15 segundos." } }
      }
    },
    "calibration.permissionDenied" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone access is required to calibrate." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se necesita acceso al micrófono para calibrar." } }
